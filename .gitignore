# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.elf
*.uf2
/build/

# Test binaries and artifacts
*.test
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace files
go.work
go.work.sum

# Environment and OS files
.env
.DS_Store
